diff --git b/Foundation/Math/Wm3IVector2.h b/Foundation/Math/Wm3IVector2.h
new file mode 100644
index 0000000000000000000000000000000000000000..4e1ad8808a702f28f337768bcf8d06625fb0652e
--- /dev/null
+++ b/Foundation/Math/Wm3IVector2.h
@@ -0,0 +1,85 @@
+// FAF MOD: GPG's integer 2-vector. Not part of upstream Wild Magic 3.8; the
+// FA binary's RTTI names it `Wm3::IVector2<int>` (the key of
+// CAiBrain::mBuildStructureMap, gpg::SerSaveLoadHelper<Wm3::IVector2<int>>,
+// the return type of RD3DTextureResource::SheetGetOriginalTextureDimensions).
+// There is no `Wm3::Vector2<int>` anywhere in the binary.
+
+#ifndef WM3IVECTOR2_H
+#define WM3IVECTOR2_H
+
+namespace gpg
+{
+    class ReadArchive;
+    class WriteArchive;
+}
+
+namespace Wm3
+{
+
+template <class Int>
+class IVector2
+{
+public:
+    // construction
+    constexpr IVector2 () noexcept : m_aiTuple{Int(0), Int(0)} {}
+    constexpr IVector2 (Int iX, Int iY) noexcept : m_aiTuple{iX, iY} {}
+
+    // coordinate access
+    Int operator[] (int i) const { return m_aiTuple[i]; }
+    Int& operator[] (int i) { return m_aiTuple[i]; }
+    Int X () const { return x; }
+    Int& X () { return x; }
+    Int Y () const { return y; }
+    Int& Y () { return y; }
+
+    // comparison
+    bool operator== (const IVector2& rkV) const
+    {
+        return x == rkV.x && y == rkV.y;
+    }
+    bool operator!= (const IVector2& rkV) const
+    {
+        return !(*this == rkV);
+    }
+
+    // Lexicographic, component by component, signed. The build-structure
+    // map's lower-bound walk (0x005808D0) inlines it as a two-iteration
+    // `jl`/`jg` loop.
+    bool operator< (const IVector2& rkV) const
+    {
+        for (int i = 0; i < 2; ++i)
+        {
+            if (m_aiTuple[i] < rkV.m_aiTuple[i])
+            {
+                return true;
+            }
+            if (m_aiTuple[i] > rkV.m_aiTuple[i])
+            {
+                return false;
+            }
+        }
+        return false;
+    }
+
+    // Serialize hooks used by the FAF reflection system. The int
+    // specializations are defined in src/sdk/moho/math/MathReflection.cpp.
+    void MemberDeserialize (gpg::ReadArchive* archive);
+    void MemberSerialize (gpg::WriteArchive* archive) const;
+
+    union
+    {
+        Int m_aiTuple[2];
+        struct
+        {
+            Int x;
+            Int y;
+        };
+    };
+};
+
+typedef IVector2<int> Vector2i;
+typedef IVector2<int> Vec2i;
+
+}
+
+#endif
