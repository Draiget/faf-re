+	              uint16_t localPort, uint16_t remotePort, size_t maxMessageSize);
+	~DcSctpBackend();
+
+	void connect();
+	void close();
+	void closeStream(unsigned int stream);
+	bool send(message_ptr message);
+	void incoming(message_ptr message);
