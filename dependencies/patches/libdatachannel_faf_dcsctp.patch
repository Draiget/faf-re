+++ b/src/impl/dcsctpbackend.cpp
@@ -0,0 +1,272 @@
+#include "dcsctpbackend.hpp"
+#include "sctptransport.hpp"
+#include "threadpool.hpp"
+
+#include "net/dcsctp/public/dcsctp_socket_factory.h"
+#include "net/dcsctp/public/dcsctp_socket.h"
+#include "net/dcsctp/public/dcsctp_options.h"
+#include "net/dcsctp/public/types.h"
+#include "net/dcsctp/public/dcsctp_message.h"
+#include "net/dcsctp/public/timeout.h"
+#include "api/units/time_delta.h"
+#include "api/units/timestamp.h"
+
+#include <atomic>
+#include <mutex>
+#include <random>
+#include <vector>
+#include <stdexcept>
+#include <iostream>
+
+#include "plog/Log.h"
+
+namespace rtc::impl {
+
+struct DcSctpBackend::Impl : public dcsctp::DcSctpSocketCallbacks,
+                             public std::enable_shared_from_this<DcSctpBackend::Impl> {
+	SctpTransport *transport = nullptr;
+	size_t maxMessageSize = 262144;
+	std::unique_ptr<dcsctp::DcSctpSocketInterface> socket;
+	std::recursive_mutex mutex;
+	std::atomic<size_t> bytesSent{0};
+	std::atomic<size_t> bytesReceived{0};
+
+	class DcSctpTimeout final : public dcsctp::Timeout {
+	public:
+		DcSctpTimeout(std::weak_ptr<DcSctpBackend::Impl> parent) : mParent(std::move(parent)) {}
+		~DcSctpTimeout() override { Stop(); }
+
+		void Start(dcsctp::DurationMs duration, dcsctp::TimeoutID timeout_id) override {
+			uint64_t gen = ++mGeneration;
+			mActiveFlag->store(gen);
+			ThreadPool::Instance().schedule(std::chrono::milliseconds(*duration),
+			    [weak = mParent, gen, timeout_id, flag = mActiveFlag]() {
+				    if (flag->load() == gen) {
+					    if (auto p = weak.lock()) {
+						    p->handleTimeout(timeout_id);
+					    }
+				    }
+			    });
+		}
+
+		void Stop() override {
+			mActiveFlag->store(0);
+		}
+
+	private:
+		std::weak_ptr<DcSctpBackend::Impl> mParent;
+		std::atomic<uint64_t> mGeneration{0};
+		std::shared_ptr<std::atomic<uint64_t>> mActiveFlag = std::make_shared<std::atomic<uint64_t>>(0);
+	};
+
+	void handleTimeout(dcsctp::TimeoutID timeout_id) {
+		std::lock_guard lock(mutex);
+		if (socket) {
+			socket->HandleTimeout(timeout_id);
+		}
+	}
+
+	// --- dcsctp::DcSctpSocketCallbacks implementation ---
+
+	dcsctp::SendPacketStatus SendPacketWithStatus(std::span<const uint8_t> data) override {
+		try {
+			const auto *raw = reinterpret_cast<const std::byte *>(data.data());
+			if (!transport->triggerOutgoing(make_message(raw, raw + data.size())))
+				return dcsctp::SendPacketStatus::kError;
+			bytesSent += data.size();
+			return dcsctp::SendPacketStatus::kSuccess;
+		} catch (...) {
+			return dcsctp::SendPacketStatus::kError;
+		}
+	}
+
+	std::unique_ptr<dcsctp::Timeout> CreateTimeout(webrtc::TaskQueueBase::DelayPrecision) override {
+		return std::make_unique<DcSctpTimeout>(weak_from_this());
+	}
+
+	webrtc::Timestamp Now() override {
+		auto ms = std::chrono::duration_cast<std::chrono::milliseconds>(
+		              std::chrono::steady_clock::now().time_since_epoch())
+		              .count();
+		return webrtc::Timestamp::Millis(ms);
+	}
+
+	uint32_t GetRandomInt(uint32_t low, uint32_t high) override {
+		if (low >= high)
+			return low;
+		std::random_device rd;
+		std::mt19937 gen(rd());
+		std::uniform_int_distribution<uint32_t> dis(low, high - 1);
+		return dis(gen);
+	}
+
+	void OnMessageReceived(dcsctp::DcSctpMessage message) override {
+		uint32_t ppid = *message.ppid();
+		uint16_t sid = *message.stream_id();
+		auto payload = std::move(message).ReleasePayload();
+		bytesReceived += payload.size();
+
+		Message::Type type = Message::Binary;
+		if (ppid == 50) {
+			type = Message::Control;
+		} else if (ppid == 51 || ppid == 54 || ppid == 56) {
+			type = Message::String;
+		}
+
+		const auto *raw = reinterpret_cast<const std::byte *>(payload.data());
+		auto msg = make_message(raw, raw + payload.size(), type, sid);
+		transport->triggerRecv(std::move(msg));
+	}
+
+	void OnConnected() override {
+		PLOG_DEBUG << "dcSCTP socket connected";
+		transport->triggerChangeState(Transport::State::Connected);
+	}
+
+	void OnClosed() override {
+		PLOG_DEBUG << "dcSCTP socket closed";
+		transport->triggerChangeState(Transport::State::Disconnected);
+	}
+
+	void OnError(dcsctp::ErrorKind error, std::string_view msg) override {
+		PLOG_WARNING << "dcSCTP error: " << ToString(error) << ": " << msg;
+		transport->triggerChangeState(Transport::State::Failed);
+	}
+
+	void OnAborted(dcsctp::ErrorKind error, std::string_view msg) override {
+		PLOG_WARNING << "dcSCTP aborted: " << ToString(error) << ": " << msg;
+		transport->triggerChangeState(Transport::State::Failed);
+	}
+
+	void OnConnectionRestarted() override {}
+	void OnStreamsResetFailed(std::span<const dcsctp::StreamID>, std::string_view) override {}
+	void OnStreamsResetPerformed(std::span<const dcsctp::StreamID>) override {}
+	void OnIncomingStreamsReset(std::span<const dcsctp::StreamID>) override {}
+};
+
+DcSctpBackend::DcSctpBackend(SctpTransport *transport, const Configuration &config,
+                             uint16_t localPort, uint16_t remotePort, size_t maxMessageSize)
+    : mImpl(std::make_shared<Impl>()) {
+	mImpl->transport = transport;
+	mImpl->maxMessageSize = maxMessageSize;
+
+	dcsctp::DcSctpOptions options;
+	options.local_port = localPort;
+	options.remote_port = remotePort;
+	options.max_message_size = maxMessageSize;
+	if (config.mtu.has_value()) {
+		size_t pmtu = *config.mtu - 12 - 48 - 8 - 40;
+		if (pmtu >= 500 && pmtu <= 65535)
+			options.mtu = pmtu;
+	}
+
+	mImpl->socket = dcsctp::DcSctpSocketFactory().Create("dcsctp", *mImpl, nullptr, options);
+}
+
+DcSctpBackend::~DcSctpBackend() {
+	close();
+}
+
+void DcSctpBackend::connect() {
+	mImpl->transport->triggerChangeState(Transport::State::Connecting);
+	std::lock_guard lock(mImpl->mutex);
+	if (mImpl->socket) {
+		mImpl->socket->Connect();
+	}
+}
+
+void DcSctpBackend::close() {
+	std::lock_guard lock(mImpl->mutex);
+	if (mImpl->socket) {
+		mImpl->socket->Close();
+	}
+}
+
+void DcSctpBackend::closeStream(unsigned int stream) {
+	std::lock_guard lock(mImpl->mutex);
+	if (mImpl->socket) {
+		std::vector<dcsctp::StreamID> streams = {dcsctp::StreamID(uint16_t(stream))};
+		mImpl->socket->ResetStreams(streams);
+	}
+}
+
+bool DcSctpBackend::send(message_ptr message) {
+	std::lock_guard lock(mImpl->mutex);
+	if (!mImpl->socket || mImpl->transport->state() != Transport::State::Connected)
+		return false;
+	if (!message)
+		return true;
+	if (message->size() > mImpl->maxMessageSize)
+		throw std::invalid_argument("Message size exceeds limit");
+
+	uint32_t ppid = 53; // PPID_BINARY
+	switch (message->type) {
+	case Message::String:
+		ppid = !message->empty() ? 51 : 56;
+		break;
+	case Message::Binary:
+		ppid = !message->empty() ? 53 : 57;
+		break;
+	case Message::Control:
+		ppid = 50;
+		break;
+	case Message::Reset:
+		closeStream(uint16_t(message->stream));
+		return true;
+	default:
+		return true;
+	}
+
+	dcsctp::SendOptions send_options;
+	const Reliability reliability = message->reliability ? *message->reliability : Reliability();
+	if (reliability.unordered)
+		send_options.unordered = dcsctp::IsUnordered(true);
+	if (reliability.maxPacketLifeTime.has_value())
+		send_options.lifetime = dcsctp::DurationMs(reliability.maxPacketLifeTime->count());
+	else if (reliability.maxRetransmits.has_value())
+		send_options.max_retransmissions = *reliability.maxRetransmits;
+
+	const auto *raw = reinterpret_cast<const uint8_t *>(message->data());
+	std::vector<uint8_t> payload(raw, raw + message->size());
+	dcsctp::DcSctpMessage dcsctp_msg(
+	    dcsctp::StreamID(uint16_t(message->stream)),
+	    dcsctp::PPID(ppid),
+	    std::move(payload));
+
+	auto status = mImpl->socket->Send(std::move(dcsctp_msg), send_options);
+	return status == dcsctp::SendStatus::kSuccess;
+}
+
+void DcSctpBackend::incoming(message_ptr message) {
+	if (!message || message->empty())
+		return;
+	std::lock_guard lock(mImpl->mutex);
+	if (mImpl->socket) {
+		mImpl->socket->ReceivePacket(std::span<const uint8_t>(
+		    reinterpret_cast<const uint8_t *>(message->data()), message->size()));
+	}
+}
+
+unsigned int DcSctpBackend::maxStream() const {
+	return 65534;
+}
+
+size_t DcSctpBackend::bytesSent() const {
+	return mImpl->bytesSent.load();
+}
+
+size_t DcSctpBackend::bytesReceived() const {
+	return mImpl->bytesReceived.load();
+}
+
+std::optional<std::chrono::milliseconds> DcSctpBackend::rtt() const {
+	std::lock_guard lock(mImpl->mutex);
+	if (!mImpl->socket)
+		return std::nullopt;
+	auto metrics = mImpl->socket->GetMetrics();
+	if (metrics && metrics->srtt_ms > 0)
+		return std::chrono::milliseconds(metrics->srtt_ms);
+	return std::nullopt;
+}
+
+} // namespace rtc::impl
