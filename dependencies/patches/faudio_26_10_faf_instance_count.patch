+/* faf-re: lower the counts only for a Cue that raised them in play_sound().
+ * Lowering them for a Cue that never played (refused by a FAIL instance
+ * limit, or prepared and destroyed) wrapped the uint8_t counts to 255, after
+ * which every later play of that Cue or Category was refused.
+ */
+void FACT_INTERNAL_ReleaseCueInstance(FACTCue *cue)
+{
+	if (cue->countedInstance)
+	{
+		cue->data->instanceCount -= 1;
+		cue->countedInstance = false;
+	}
+}
+
+void FACT_INTERNAL_ReleaseCueCategory(FACTCue *cue)
+{
+	if (cue->countedCategory != NULL)
+	{
+		cue->countedCategory->instanceCount -= 1;
+		cue->countedCategory = NULL;
+	}
+}
