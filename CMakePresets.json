{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "clang-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "clang-x64-release",
      "displayName": "clang-cl x64 Release (main_x64.exe)",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang-x86-release",
      "displayName": "clang-cl x86 Release (main.exe)",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "clang-x64-profile",
      "displayName": "clang-cl x64 Profile with Tracy (main_x64.exe)",
      "inherits": "clang-x64-release",
      "cacheVariables": { "FAF_ENABLE_TRACY": "ON" }
    },
    {
      "name": "clang-x86-profile",
      "displayName": "clang-cl x86 Profile with Tracy (main.exe)",
      "inherits": "clang-x86-release",
      "cacheVariables": { "FAF_ENABLE_TRACY": "ON" }
    },
    {
      "name": "clang-x64-debug",
      "displayName": "clang-cl x64 Debug",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-x86-debug",
      "displayName": "clang-cl x86 Debug",
      "inherits": "clang-base",
      "toolchainFile": "${sourceDir}/cmake/toolchains/clang-cl-x86.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "clang-x64-release-server",
      "displayName": "clang-cl x64 Release with server mode (main_x64.exe)",
      "inherits": "clang-x64-release",
      "cacheVariables": { "FAF_SERVER_MODE": "ON" }
    },
    {
      "name": "clang-x86-release-server",
      "displayName": "clang-cl x86 Release with server mode (main.exe)",
      "inherits": "clang-x86-release",
      "cacheVariables": { "FAF_SERVER_MODE": "ON" }
    },
    {
      "name": "linux-clang-x64-release",
      "displayName": "Linux clang x64 Release (headless simulation)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "toolchainFile": "${sourceDir}/cmake/toolchains/linux-clang-x64.cmake",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "clang-x64-release", "configurePreset": "clang-x64-release" },
    { "name": "clang-x86-release", "configurePreset": "clang-x86-release" },
    { "name": "clang-x64-profile", "configurePreset": "clang-x64-profile" },
    { "name": "clang-x86-profile", "configurePreset": "clang-x86-profile" },
    { "name": "clang-x64-debug", "configurePreset": "clang-x64-debug" },
    { "name": "clang-x86-debug", "configurePreset": "clang-x86-debug" },
    { "name": "clang-x64-release-server", "configurePreset": "clang-x64-release-server" },
    { "name": "clang-x86-release-server", "configurePreset": "clang-x86-release-server" },
    { "name": "linux-clang-x64-release", "configurePreset": "linux-clang-x64-release" }
  ]
}
