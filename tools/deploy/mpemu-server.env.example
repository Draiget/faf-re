# /etc/mpemu/mpemu-server.env (mode 0600). deploy-remote.ps1 writes the real
# one; this template documents the keys. Never commit a filled-in copy.

# Shared secret: agents, directors and ICE adapters must use the same value.
# It also keys the API's TLS certificate (hub.ServerTLS).
MPEMU_SECRET=<generated; lives in your local secret file, never in the repo>

# The name machines reach the hub by (TURN URLs carry it as-is). It may exist
# only in the LAN's DNS (fw0); the hub then announces its outbound address.
MPEMU_PUBLIC_HOST=faftest.zontwelg.net

# Only if that fallback picks the wrong address (NAT in front of the host):
# the public IPv4 TURN announces.
#MPEMU_PUBLIC_IP=

# API (TLS), TURN/STUN, TURN relay allocations, and the game relay. Every
# port must be free on the host and open in its firewall; keep the ranges
# small where a firewall forwards single ports (fw0 has no port ranges).
# 3479, not 3478: the VPN servers' ShadowLink already listens on UDP 3478.
MPEMU_HTTP=0.0.0.0:8443
MPEMU_TURN_PORT=3479
MPEMU_TURN_RELAY_PORTS=40000-40015
MPEMU_RELAY_PORTS=40100-40131
