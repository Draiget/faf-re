# Engine addition (issue #215): the git commit the engine is built from, compiled
# into the executable (gpg/core/diagnostics/BuildInfo.h).
#
# faf_build_info(<target>) adds the build step faf_build_info, which runs on every
# build and writes ${CMAKE_BINARY_DIR}/generated/faf/BuildInfoGenerated.h only
# when a value changed: a new commit or a local edit shows without reconfiguring,
# and an unchanged tree recompiles nothing. BuildInfo.cpp includes the header, and so does
# the exe's version resource (src/moho/app/MohoVersion.rc, issue #314).
# The same step writes faf/EngineSwitchesGenerated.h, the switch names in docs/SWITCHES.md
# (DesyncRecorder.cpp).
#
# The same file is the step's script (cmake -P), which reads git and writes the
# header.

if(CMAKE_SCRIPT_MODE_FILE)
  # --- Script mode: FAF_SOURCE_DIR, FAF_OUT, FAF_ARCH, FAF_CONFIG ----------------------
  set(_commit "unknown")
  set(_short "unknown")
  set(_describe "unknown")
  set(_branch "unknown")
  set(_dirty 0)

  find_program(_git git)
  if(_git)
    execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" rev-parse HEAD
      OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
    if(_rc EQUAL 0 AND _out)
      set(_commit "${_out}")
      string(SUBSTRING "${_commit}" 0 7 _short)

      # Local edits to tracked files make the build "-dirty"; untracked files and the pinned
      # dependency submodules don't. A status that fails can't prove the tree clean, so it
      # counts as dirty (a worktree whose submodule folders link elsewhere fails here).
      execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" status --porcelain --untracked-files=no --ignore-submodules=all
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT _rc EQUAL 0 OR _out)
        set(_dirty 1)
      endif()

      # A commit that has a tag is that tag, a nightly's too. Others count from the last release,
      # not from a nightly: tools/release/README.md.
      execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" describe --tags --exact-match
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(NOT _rc EQUAL 0)
        execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" describe --tags --abbrev=7 --exclude=*-nightly*
          OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      endif()
      if(_rc EQUAL 0 AND _out AND _dirty)
        set(_describe "${_out}-dirty")
      elseif(_rc EQUAL 0 AND _out)
        set(_describe "${_out}")
      elseif(_dirty)
        set(_describe "${_short}-dirty")
      else()
        set(_describe "${_short}")
      endif()

      # A clean build of a commit tagged as a release or nightly (2026.11.001, 2026.11.002-nightly)
      # goes by that tag, a release before a nightly, the highest number among releases. Old
      # tags such as v1.1.2 and 2026.05.11.001-nightly don't count: tools/release/README.md.
      if(NOT _dirty)
        execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" tag --points-at HEAD --sort=version:refname
          OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
        if(_rc EQUAL 0 AND _out)
          string(REPLACE "\n" ";" _tags "${_out}")
          foreach(_tag IN LISTS _tags)
            if(_tag MATCHES "^[0-9][0-9][0-9][0-9]\\.[0-9][0-9]\\.[0-9]+$")
              set(_version "${_tag}")
            elseif(NOT _version AND _tag MATCHES "^[0-9][0-9][0-9][0-9]\\.[0-9][0-9]\\.[0-9]+-nightly$")
              set(_version "${_tag}")
            endif()
          endforeach()
        endif()
        if(_version)
          set(_describe "${_version}")
        endif()
      endif()

      execute_process(COMMAND "${_git}" -C "${FAF_SOURCE_DIR}" branch --show-current
        OUTPUT_VARIABLE _out RESULT_VARIABLE _rc OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
      if(_rc EQUAL 0 AND _out)
        set(_branch "${_out}")
      else()
        set(_branch "detached")
      endif()
    endif()
  endif()

  # What the label shown to players calls this build.
  if(_version)
    set(_shown "${_version}")
  elseif(_dirty)
    set(_shown "${_short}-dirty")
  else()
    set(_shown "${_short}")
  endif()

  # The tag as the version resource's numbers (src/moho/app/MohoVersion.rc): 2026.11.001 and
  # 2026.11.001-nightly are 2026,11,1,0. Builds without such a tag are 0,0,0,0.
  set(_numbers "0,0,0,0")
  if(_version MATCHES "^([0-9]+)\\.([0-9]+)\\.([0-9]+)")
    math(EXPR _year "${CMAKE_MATCH_1}")
    math(EXPR _month "${CMAKE_MATCH_2}")
    math(EXPR _build "${CMAKE_MATCH_3}")
    set(_numbers "${_year},${_month},${_build},0")
  endif()

  set(_text "// Generated by cmake/FafBuildInfo.cmake on every build; do not edit.\n#pragma once\n\n")
  string(APPEND _text "#define FAF_BUILD_COMMIT \"${_commit}\"\n")
  string(APPEND _text "#define FAF_BUILD_COMMIT_SHORT \"${_short}\"\n")
  string(APPEND _text "#define FAF_BUILD_SHOWN \"${_shown}\"\n")
  string(APPEND _text "#define FAF_BUILD_VERSION_NUMBERS ${_numbers}\n")
  string(APPEND _text "#define FAF_BUILD_DESCRIBE \"${_describe}\"\n")
  string(APPEND _text "#define FAF_BUILD_BRANCH \"${_branch}\"\n")
  string(APPEND _text "#define FAF_BUILD_DIRTY ${_dirty}\n")
  string(APPEND _text "#define FAF_BUILD_ARCH \"${FAF_ARCH}\"\n")
  string(APPEND _text "#define FAF_BUILD_CONFIG \"${FAF_CONFIG}\"\n")

  file(WRITE "${FAF_OUT}.tmp" "${_text}")
  file(COPY_FILE "${FAF_OUT}.tmp" "${FAF_OUT}" ONLY_IF_DIFFERENT)
  file(REMOVE "${FAF_OUT}.tmp")

  # The engine's own switches, as docs/SWITCHES.md's tables name them (first column), for the
  # desync dump and telemetry (moho/sim/DesyncRecorder.cpp). telemetry_* stays out: it holds the
  # endpoints and the token.
  set(_names "")
  file(STRINGS "${FAF_SOURCE_DIR}/docs/SWITCHES.md" _rows REGEX "^[|] `[A-Za-z]+_[A-Za-z0-9_]+` [|]")
  foreach(_row IN LISTS _rows)
    if(_row MATCHES "^[|] `([A-Za-z]+_[A-Za-z0-9_]+)` [|]")
      set(_name "${CMAKE_MATCH_1}") # the next MATCHES overwrites CMAKE_MATCH_1
      if(NOT _name MATCHES "^telemetry_")
        list(APPEND _names "${_name}")
      endif()
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _names)
  list(SORT _names)
  set(_text "// Generated by cmake/FafBuildInfo.cmake from docs/SWITCHES.md on every build; do not edit.\n#pragma once\n\n")
  string(APPEND _text "#define FAF_ENGINE_SWITCHES \\\n")
  foreach(_name IN LISTS _names)
    string(APPEND _text "  \"${_name}\\n\" \\\n")
  endforeach()
  string(APPEND _text "  \"\"\n")
  get_filename_component(_dir "${FAF_OUT}" DIRECTORY)
  file(WRITE "${_dir}/EngineSwitchesGenerated.h.tmp" "${_text}")
  file(COPY_FILE "${_dir}/EngineSwitchesGenerated.h.tmp" "${_dir}/EngineSwitchesGenerated.h" ONLY_IF_DIFFERENT)
  file(REMOVE "${_dir}/EngineSwitchesGenerated.h.tmp")
  return()
endif()

# --- Configure mode -----------------------------------------------------------------------
set(_faf_build_info_dir "${CMAKE_BINARY_DIR}/generated")
set(_faf_build_info_header "${_faf_build_info_dir}/faf/BuildInfoGenerated.h")
set(_faf_build_info_script "${CMAKE_CURRENT_LIST_FILE}")

function(faf_build_info target arch)
  if(NOT TARGET faf_build_info)
    add_custom_target(faf_build_info
      BYPRODUCTS "${_faf_build_info_header}" "${_faf_build_info_dir}/faf/EngineSwitchesGenerated.h"
      COMMAND "${CMAKE_COMMAND}"
        "-DFAF_SOURCE_DIR=${PROJECT_SOURCE_DIR}"
        "-DFAF_OUT=${_faf_build_info_header}"
        "-DFAF_ARCH=${arch}"
        "-DFAF_CONFIG=${CMAKE_BUILD_TYPE}"
        -P "${_faf_build_info_script}"
      COMMENT "Reading the git commit for BuildInfo"
      VERBATIM)
  endif()
  add_dependencies(${target} faf_build_info)
  target_include_directories(${target} PRIVATE "${_faf_build_info_dir}")
endfunction()
