// Host-only allocator/camera adapter. See README.
#include "SplatBudget.h"
#include <gtest/gtest.h>
#include <cstdio>
#include <cstdlib>
#include <new>
#include <vector>
#include <algorithm>
#include <chrono>
#include <thread>
#include <climits>
#include <string>
int moho::ren_SplatBudgetTier=0;
static bool track=false,fail=false;
// Evaluate production expressions first, then exclude GoogleTest diagnostics
// from deterministic allocation injection. The previous state is restored.
struct PauseTracking {
  bool previous=track;
  PauseTracking(){track=false;}
  ~PauseTracking(){track=previous;}
};
static std::size_t attempts=0,live=0,peak=0,lastRequest=0,failAttempt=0;
struct Allocation {
  void*p;
  std::size_t n;
};
static Allocation allocations[256] {
};
void*operator new(std::size_t n) {
  if(track) {
    ++attempts;
    lastRequest=n;
    if(fail||attempts==failAttempt)throw std::bad_alloc();
  }
  void*p=std::malloc(n?n:1);
  if(!p)throw std::bad_alloc();
  if(track) {
    bool added=false;
    for(auto&a:allocations)if(!a.p) {
      a= {
        p,n
      };
      added=true;
      break;
    }
    if(!added) {
      track=false;
      ADD_FAILURE() << "Host allocation tracking slots exhausted";
      std::free(p);
      throw std::bad_alloc();
    }
    live+=n;
    peak=std::max(peak,live);
  }
  return p;
}
void operator delete(void*p)noexcept {
  for(auto&a:allocations)if(a.p==p&&p) {
    live-=a.n;
    a= {
    };
    break;
  }
  std::free(p);
}
void operator delete(void*p,std::size_t)noexcept {
  ::operator delete(p);
}
// GoogleTest's stable-sort uses nothrow new. Keep every ordinary new/delete
// overload on the same malloc/free path under ASan, without suppressing errors.
void* operator new(std::size_t n,const std::nothrow_t&) noexcept {
  try { return ::operator new(n); } catch(const std::bad_alloc&) { return nullptr; }
}
void operator delete(void* p,const std::nothrow_t&) noexcept { ::operator delete(p); }
void* operator new[](std::size_t n) { return ::operator new(n); }
void* operator new[](std::size_t n,const std::nothrow_t& tag) noexcept { return ::operator new(n,tag); }
void operator delete[](void* p) noexcept { ::operator delete(p); }
void operator delete[](void* p,std::size_t) noexcept { ::operator delete(p); }
void operator delete[](void* p,const std::nothrow_t&) noexcept { ::operator delete(p); }
struct DisarmInjection {
  ~DisarmInjection(){track=false; fail=false; failAttempt=0;}
};
using namespace moho;
struct Vector4f {
  float x=0,y=0,z=1,w=0;
};
struct View {
  Vector4f r[2];
};
struct Camera {
  View viewport;
};
float ren_DecalFadeFraction=.5f;
void*sHighFidelityTextureBatcher=nullptr,*sMediumFidelityTextureBatcher=nullptr,*texture_batcher=nullptr;
template<std::size_t N>struct Lane {
  gpg::core::FastVectorN<CWldSplat::SplatVertex,N> mSplatVertices;
  Camera camera;
  Camera*mCamera=&camera;
#ifdef HAS_BASELINE
  void BaseHigh(std::vector<CWldTerrainDecal*>&);
  void BaseMedium(std::vector<CWldTerrainDecal*>&);
  void BaseLow(std::vector<CWldTerrainDecal*>&);
#endif
  void NewHigh(std::vector<CWldTerrainDecal*>&);
  void NewMedium(std::vector<CWldTerrainDecal*>&);
  void NewLow(std::vector<CWldTerrainDecal*>&);
};
@METHODS@
static std::vector<CWldSplat> objects(100005);
static void fill(std::vector<CWldTerrainDecal*>&v,std::size_t begin,std::size_t n,bool filtered=false) {
  v.clear();
  for(std::size_t i=begin;i<begin+n;++i) {
    auto&o=objects[i];
    o.mFidelity=0;
    o.mCutoffLOD=100;
    o.mNearCutoff=0;
    o.mCurrentAlpha=1;
    for(auto&w:o.mSplatVertices) {
      w.mPosition.x=float(i);
      w.mPosition.z=filtered?200:0;
      w.mAlpha=.25f;
      w.mTexCoord.x=.2f;
    }
    v.push_back(&o);
  }
}
template<std::size_t N>static bool has(Lane<N>&lane,std::size_t id) {
  for(std::size_t i=0;i<lane.mSplatVertices.Size();i+=4)if(lane.mSplatVertices[i].mPosition.x==float(id))return true;
  return false;
}
static void reset() {
  {
    const bool passed=(live==0);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "live==0";
  }
  track=false;
  fail=false;
  attempts=peak=failAttempt=0;
  splat_detail::Backoff()= {
  };
}
template<std::size_t N,class Method>void cases(const char*name,Method newM) {
  const DisarmInjection disarm;
  const std::size_t cap=N/4;
  std::vector<CWldTerrainDecal*>v;
  v.reserve(objects.size());
  std::size_t nCases=0;
  for(int tier: {
    INT_MIN,-1,0,1,2,3,4,INT_MAX
  }) {
    ren_SplatBudgetTier=tier;
    const auto limit=tier==1?cap*4:tier==2?cap*10:tier==3?cap*20:cap-1;
    Lane<N> newLane;
    for(std::size_t n: {
      0UL,1UL,248UL,249UL,250UL,251UL,999UL,1000UL,1001UL,2498UL,2499UL,2500UL,2501UL,4999UL,5000UL,5001UL,9999UL,10000UL,10001UL,16384UL,16385UL,24999UL,25000UL,25001UL,40000UL,49999UL,50000UL,50001UL,100000UL
    }) {
      fill(v,0,n);
      textureCalls=vertexCalls=0;
      (newLane.*newM)(v);
      {
        const bool passed=(textureCalls==std::min(n,limit));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "textureCalls==std::min(n,limit)";
      }
      {
        const bool passed=(vertexCalls==(std::string(name)=="High"?std::min(n,limit):0));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "vertexCalls==(std::string(name)==\"High\"?std::min(n,limit):0)";
      }
      {
        const bool passed=(newLane.mSplatVertices.Size()==std::min(n,limit)*4);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "newLane.mSplatVertices.Size()==std::min(n,limit)*4";
      }
      {
        const bool passed=(newLane.mSplatVertices.Capacity()<=std::max(cap,limit)*4);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "newLane.mSplatVertices.Capacity()<=std::max(cap,limit)*4";
      }
      for(std::size_t i=0;i<newLane.mSplatVertices.Size();++i) {
        const auto&w=newLane.mSplatVertices[i];
        {
          const bool passed=(w.mPosition.x==float(i/4)&&w.mTexCoord.x==.2f&&w.mAlpha==2.f);
          const PauseTracking pause;
          ASSERT_TRUE(passed) << "w.mPosition.x==float(i/4)&&w.mTexCoord.x==.2f&&w.mAlpha==2.f";
        }
      }
      ++nCases;
    }
  }
  // Default and invalid values must not allocate or mutate shared TLS state,
  // even when their candidate set is enormous or entirely filtered out.
  for(int tier: {
    INT_MIN,-1,0,4,INT_MAX
  }) {
    reset();
    ren_SplatBudgetTier=tier;
    auto& state=splat_detail::Backoff();
    state.failedBytes=123456;
    state.skippedCalls=17;
    {
      Lane<N> lane;
      fill(v,0,100000);
      textureCalls=vertexCalls=0;
      track=true;
      (lane.*newM)(v);
      track=false;
      {
        const bool passed=(attempts==0&&live==0&&lane.mSplatVertices.Size()==(cap-1)*4);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "attempts==0&&live==0&&lane.mSplatVertices.Size()==(cap-1)*4";
      }
      {
        const bool passed=(state.failedBytes==123456&&state.skippedCalls==17);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "state.failedBytes==123456&&state.skippedCalls==17";
      }
      {
        const bool passed=(textureCalls==cap-1&&vertexCalls==(std::string(name)=="High"?cap-1:0));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "textureCalls==cap-1&&vertexCalls==(std::string(name)==\"High\"?cap-1:0)";
      }
      fill(v,0,100000,true);
      track=true;
      (lane.*newM)(v);
      track=false;
      {
        const bool passed=(attempts==0&&lane.mSplatVertices.Empty());
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "attempts==0&&lane.mSplatVertices.Empty()";
      }
      {
        const bool passed=(state.failedBytes==123456&&state.skippedCalls==17);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "state.failedBytes==123456&&state.skippedCalls==17";
      }
    }
    reset();
  }
  // Independent fade cases include far/near cutoffs and source alpha scaling.
  {
    Lane<N> lane;
    ren_SplatBudgetTier=0;
    const float distance[]= {
      0,50,75,100,101,0,50,75,100
    };
    const float nearCutoff[]= {
      0,0,0,0,0,100,100,100,100
    };
    const float expected[]= {
      1,.5f,.25f,0,0,0,0,.25f,.5f
    };
    for(std::size_t i=0;i<9;++i) {
      fill(v,0,1);
      objects[0].mCurrentAlpha=.5f;
      objects[0].mNearCutoff=nearCutoff[i];
      for(auto&w:objects[0].mSplatVertices)w.mPosition.z=distance[i];
      textureCalls=vertexCalls=0;
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Size()==(i==4?0:4));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==(i==4?0:4)";
      }
      for(auto&w:lane.mSplatVertices){
        const bool passed=(w.mAlpha==expected[i]);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "w.mAlpha==expected[i]";
      }
      {
        const bool passed=(textureCalls==(i==4?0:1));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "textureCalls==(i==4?0:1)";
      }
    }
  }
  ren_SplatBudgetTier=1;
  {
    Lane<N> newLane;
    // Same splat in both views, changed preceding visible membership.
    fill(v,0,cap*2);
    (newLane.*newM)(v);
    const auto target=cap+10;
    {
      const bool passed=(has(newLane,target));
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "has(newLane,target)";
    }
    fill(v,cap,cap);
    (newLane.*newM)(v);
    {
      const bool passed=(has(newLane,target));
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "has(newLane,target)";
    }
  }
  // Filtering BEFORE growth: enormous candidate set but <=inline eligible.
  reset();
  track=true;
  {
    Lane<N> lane;
    fill(v,0,100000,true);
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Empty()&&attempts==0);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Empty()&&attempts==0";
    }
    fill(v,0,100000,true);
    for(std::size_t i=0;i<100;++i)for(auto&w:objects[i*2].mSplatVertices)w.mPosition.z=0;
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Size()==400&&attempts==0);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==400&&attempts==0";
    }
    if(N==1000) {
      fill(v,0,100000);
      for(auto*p:v)static_cast<CWldSplat*>(p)->mFidelity=1;
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Empty()&&attempts==0);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Empty()&&attempts==0";
      }
    }
  }
  reset();
  // Transparency and empty view clearing preserve original accounting.
  {
    Lane<N> lane;
    fill(v,0,cap+1);
    for(auto*p:v)static_cast<CWldSplat*>(p)->mCurrentAlpha=0;
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Size()==(cap+1)*4);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==(cap+1)*4";
    }
    for(const auto&w:lane.mSplatVertices){
      const bool passed=(w.mAlpha==0);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "w.mAlpha==0";
    }
    v.clear();
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Empty());
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Empty()";
    }
  }
  // Failed growth after full inline prefix: one attempt then 32 overflow skips.
  reset();
  fill(v,0,cap+1);
  track=true;
  {
    Lane<N> lane;
    fail=true;
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Size()==cap*4&&attempts==1&&live==0);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==cap*4&&attempts==1&&live==0";
    }
    for(int i=0;i<32;++i) {
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Size()==cap*4&&attempts==1);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==cap*4&&attempts==1";
      }
    }
    fail=false;
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Size()==(cap+1)*4&&attempts==2&&live==cap*2*112);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==(cap+1)*4&&attempts==2&&live==cap*2*112";
    }
    for(std::size_t i=0;i<lane.mSplatVertices.Size();++i){
      const bool passed=(lane.mSplatVertices[i].mPosition.x==float(i/4));
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices[i].mPosition.x==float(i/4)";
    }
    auto*ptr=lane.mSplatVertices.data();
    const auto a=attempts;
    v.clear();
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.data()==ptr&&attempts==a);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.data()==ptr&&attempts==a";
    }
    // Tier down releases oversized heap, invalid and original reset to inline.
    ren_SplatBudgetTier=0;
    (lane.*newM)(v);
    {
      const bool passed=(live==0&&lane.mSplatVertices.Capacity()==N);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "live==0&&lane.mSplatVertices.Capacity()==N";
    }
  }
  reset();
  // Peak bytes and allocations bounded per tier; settled frames allocate nothing.
  for(int tier: {
    1,2,3
  }) {
    ren_SplatBudgetTier=tier;
    const auto limit=cap*(tier==1?4:tier==2?10:20);
    fill(v,0,limit+1);
    track=true;
    {
      Lane<N> lane;
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Size()==limit*4&&live==limit*112&&peak<=limit*112*2);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==limit*4&&live==limit*112&&peak<=limit*112*2";
      }
      const auto a=attempts;
      {
        const bool passed=(a<=5);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "a<=5";
      }
      (lane.*newM)(v);
      {
        const bool passed=(attempts==a);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "attempts==a";
      }
      std::printf("%s tier %d: limit=%zu heap=%zu peak_heap=%zu allocations=%zu\n",name,tier,limit,live,peak,attempts);
      ren_SplatBudgetTier=1;
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Size()==cap*4*4&&live==cap*4*112);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==cap*4*4&&live==cap*4*112";
      }
      ren_SplatBudgetTier=INT_MAX;
      (lane.*newM)(v);
      {
        const bool passed=(lane.mSplatVertices.Size()==(cap-1)*4&&live==0);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==(cap-1)*4&&live==0";
      }
    }
    reset();
  }
  // OOM at heap->heap growth must retain earlier live vertices.
  ren_SplatBudgetTier=3;
  fill(v,0,cap*2);
  track=true;
  {
    Lane<N> lane;
    (lane.*newM)(v);
    {
      const bool passed=(live==cap*2*112);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "live==cap*2*112";
    }
    fill(v,0,cap*2+1);
    fail=true;
    (lane.*newM)(v);
    {
      const bool passed=(lane.mSplatVertices.Size()==cap*2*4&&live==cap*2*112);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices.Size()==cap*2*4&&live==cap*2*112";
    }
    for(std::size_t i=0;i<lane.mSplatVertices.Size();++i){
      const bool passed=(lane.mSplatVertices[i].mPosition.x==float(i/4));
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "lane.mSplatVertices[i].mPosition.x==float(i/4)";
    }
  }
  reset();
  // Inject each of the five geometric-growth failures, not only first Reserve.
  for(std::size_t failure=1;failure<=5;++failure) {
    reset();
    ren_SplatBudgetTier=3;
    fill(v,0,cap*20+1);
    failAttempt=failure;
    track=true;
    {
      Lane<N> lane;
      (lane.*newM)(v);
      const auto kept=cap*(std::size_t(1)<<(failure-1));
      {
        const bool passed=(attempts==failure&&lane.mSplatVertices.Size()==kept*4);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "attempts==failure&&lane.mSplatVertices.Size()==kept*4";
      }
      for(std::size_t i=0;i<lane.mSplatVertices.Size();++i){
        const bool passed=(lane.mSplatVertices[i].mPosition.x==float(i/4));
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "lane.mSplatVertices[i].mPosition.x==float(i/4)";
      }
      {
        const bool passed=(splat_detail::Backoff().skippedCalls==32);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "splat_detail::Backoff().skippedCalls==32";
      }
      (lane.*newM)(v);
      {
        const bool passed=(attempts==failure&&lane.mSplatVertices.Size()==kept*4);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "attempts==failure&&lane.mSplatVertices.Size()==kept*4";
      }
    }
    reset();
  }
  std::printf("%s: %zu tier/count combinations, view churn, filtered huge sets, zero alpha, OOM/backoff/recovery/reuse/downshift PASS\n",name,nCases);
}
void backoffCases() {
  splat_detail::AllocationBackoff b;
  b.Failed(560000);
  {
    const bool passed=(b.Allow(56000));
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "b.Allow(56000)";
  }
  b.Succeeded(56000);
  {
    const bool passed=(b.failedBytes==560000&&b.skippedCalls==32);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "b.failedBytes==560000&&b.skippedCalls==32";
  }
  {
    const bool passed=(!b.Allow(560000));
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "!b.Allow(560000)";
  }
  b.Failed(56000);
  {
    const bool passed=(!b.Allow(560000));
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "!b.Allow(560000)";
  }
  for(int i=0;i<31;++i){
    const bool passed=(!b.Allow(56000));
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "!b.Allow(56000)";
  }
  {
    const bool passed=(b.Allow(56000));
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "b.Allow(56000)";
  }
  b.Succeeded(56000);
  {
    const bool passed=(b.failedBytes==0);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "b.failedBytes==0";
  }
  // Consecutive smaller failures cannot alternate indefinitely: threshold falls.
  std::size_t previous=5600000;
  unsigned failures=0;
  for(auto bytes: {
    5600000UL,4480000UL,2800000UL,2240000UL,1120000UL,560000UL,5600000UL,56000UL,560000UL
  }) {
    if(b.Allow(bytes)) {
      b.Failed(bytes);
      {
        const bool passed=(bytes<=previous);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "bytes<=previous";
      }
      previous=bytes;
      ++failures;
    }
  }
  {
    const bool passed=(failures==7);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "failures==7";
  }
  auto&shared=splat_detail::Backoff();
  shared.Failed(56000);
  std::thread worker([] {
    {
      const bool passed=(splat_detail::Backoff().failedBytes==0);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "splat_detail::Backoff().failedBytes==0";
    }splat_detail::Backoff().Failed(1);
  });
  worker.join();
  {
    const bool passed=(shared.failedBytes==56000);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "shared.failedBytes==56000";
  }
  shared= {
  };
  puts("Backoff: smaller success preserves failure, decreasing bypass threshold, cross-thread isolation PASS");
}
void snapshotCase() {
  gpg::core::FastVectorN<CWldSplat::SplatVertex,1000>v;
  auto b=PrepareSplatOutput(v,1);
  ren_SplatBudgetTier=0;
  {
    const bool passed=(b.limit==1000&&TryGrowSplatOutput(v,b)&&b.available==500);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "b.limit==1000&&TryGrowSplatOutput(v,b)&&b.available==500";
  }
  // Existing snapshot unaffected.
  auto next=PrepareSplatOutput(v,ren_SplatBudgetTier);
  {
    const bool passed=(next.limit==249&&v.Capacity()==1000);
    const PauseTracking pause;
    ASSERT_TRUE(passed) << "next.limit==249&&v.Capacity()==1000";
  }
  puts("Per-view snapshot and next-view downshift PASS");
}
#ifdef HAS_BASELINE
template<std::size_t N,class Method>
void baselineCases(Method oldM,Method newM) {
  Lane<N> oldLane,newLane;
  std::vector<CWldTerrainDecal*> v;
  v.reserve(objects.size());
  for(int tier: {
    INT_MIN,-1,0,4,INT_MAX
  }) for(std::size_t n: {
    0UL,1UL,249UL,250UL,2499UL,2500UL,100000UL
  }) {
    ren_SplatBudgetTier=tier;
    fill(v,0,n);
    textureCalls=vertexCalls=0;
    (oldLane.*oldM)(v);
    const auto tc=textureCalls,vc=vertexCalls;
    textureCalls=vertexCalls=0;
    (newLane.*newM)(v);
    {
      const bool passed=(tc==textureCalls&&vc==vertexCalls);
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "tc==textureCalls&&vc==vertexCalls";
    }
    {
      const bool passed=(oldLane.mSplatVertices.Size()==newLane.mSplatVertices.Size());
      const PauseTracking pause;
      ASSERT_TRUE(passed) << "oldLane.mSplatVertices.Size()==newLane.mSplatVertices.Size()";
    }
    for(std::size_t i=0;i<oldLane.mSplatVertices.Size();++i) {
      auto&a=oldLane.mSplatVertices[i];
      auto&b=newLane.mSplatVertices[i];
      {
        const bool passed=(a.mPosition.x==b.mPosition.x&&a.mTexCoord.x==b.mTexCoord.x&&a.mAlpha==b.mAlpha);
        const PauseTracking pause;
        ASSERT_TRUE(passed) << "a.mPosition.x==b.mPosition.x&&a.mTexCoord.x==b.mTexCoord.x&&a.mAlpha==b.mAlpha";
      }
    }
  }
}
#endif
class SplatCollection : public testing::Test {
 protected:
  void SetUp() override { track=false; reset(); }
  void TearDown() override { track=false; fail=false; failAttempt=0; }
};
TEST_F(SplatCollection, High) { cases<10000>("High",&Lane<10000>::NewHigh); }
TEST_F(SplatCollection, Medium) { cases<10000>("Medium",&Lane<10000>::NewMedium); }
TEST_F(SplatCollection, Low) { cases<1000>("Low",&Lane<1000>::NewLow); }
TEST_F(SplatCollection, Backoff) { backoffCases(); }
TEST_F(SplatCollection, Snapshot) { snapshotCase(); }
#ifdef HAS_BASELINE
TEST_F(SplatCollection, BaselineHigh) { baselineCases<10000>(&Lane<10000>::BaseHigh,&Lane<10000>::NewHigh); }
TEST_F(SplatCollection, BaselineMedium) { baselineCases<10000>(&Lane<10000>::BaseMedium,&Lane<10000>::NewMedium); }
TEST_F(SplatCollection, BaselineLow) { baselineCases<1000>(&Lane<1000>::BaseLow,&Lane<1000>::NewLow); }
#endif
