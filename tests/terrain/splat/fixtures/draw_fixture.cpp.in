#include "SplatChunkRenderer.h"
#include <cstdio>
using namespace moho;
struct DrawLane {
  std::vector<CWldSplat::SplatVertex>mSplatVertices;
  CD3DVertexSheet sheet;
  CD3DIndexSheet index;
  CD3DVertexSheet*mDynamicVertexSheet=&sheet,*mOverlayVertexSheet=&sheet;
  CD3DIndexSheet*mDynamicIndexSheet=&index,*mOverlayIndexSheet=&index;
  void NewHigh();
  void NewMedium();
  void NewLow();
#ifdef HAS_BASELINE
  void BaseHigh();
  void BaseMedium();
  void BaseLow();
#endif
};
@METHODS@
static void reset(DrawLane&lane,std::size_t n,int p,gpg::gal::EffectTechnique&t,CD3DDevice&d) {
  lane.mSplatVertices.clear();
  for(std::size_t i=0;i<n*4;++i) {
    CWldSplat::SplatVertex v {
    };
    v.mPosition.x=float(i);
    v.mPosition.y=1.25f;
    v.mPosition.z=-2;
    v.mTexCoord.x=.2f;
    v.mTexCoord.y=.7f;
    v.mAlpha=.33f;
    for(auto&byte:v.mPad18_1B)byte=0x5a;
    lane.mSplatVertices.push_back(v);
  }
  events.clear();
  records.clear();
  step=0;
  failAt=-1;
  passNow=-1;
  nullLock=false;
  curSheet=&lane.sheet;
  activeDevice=&d;
  t.passes=p;
}
void cases(const char*name,std::size_t cap,void(DrawLane::*candidate)()) {
  activeCap=cap;
  expectedTechnique=std::string(name)=="Low"?"LowFidelitySplat":"TSplats";
  gpg::gal::EffectTechnique t;
  CD3DDevice d {
    {
      {
        &t
      }
    }
  };
  DrawLane lane;
  int total=0;
  for(int p: {
    0,1,2,3
  })for(std::size_t n: {
    0UL,1UL,249UL,250UL,251UL,2499UL,2500UL,2501UL,9999UL,10000UL,10001UL,16384UL,16385UL,40000UL,100000UL
  }) {
    reset(lane,n,p,t,d);
    (lane.*candidate)();
    assert(records.size()==std::size_t(p)*n*4);
    for(int pass=0;pass<p;++pass)for(std::size_t i=0;i<n*4;++i)assert((records[pass*n*4+i]==std::pair<int,int>(pass,int(i))));
    const auto chunks=(n+cap-1)/cap;
    const auto uploads=n==0?0:n<=cap?1:std::size_t(p)*chunks;
    assert(std::size_t(std::count(events.begin(),events.end(),"lock"))==uploads);
    assert(std::size_t(std::count(events.begin(),events.end(),"draw"))==std::size_t(p)*chunks);
    // Expected event order is independent of a comparison checkout.
    std::vector<std::string> expected;
    if(n) {
      if(n<=cap) {
        expected= {
          "lock","unlock","flush","select","atlas","flush","vertexbind","indexbind","begin"
        };
        for(int pass=0;pass<p;++pass) {
          expected.push_back("beginpass");
          expected.push_back("draw");
          expected.push_back("endpass");
        }
      }
      else {
        expected= {
          "flush","select","atlas","flush","vertexbind","indexbind","begin"
        };
        for(int pass=0;pass<p;++pass) {
          expected.push_back("beginpass");
          for(std::size_t c=0;c<chunks;++c) {
            expected.push_back("lock");
            expected.push_back("unlock");
            expected.push_back("draw");
          }
          expected.push_back("endpass");
        }
      }
      expected.push_back("end");
    }
    assert(events==expected);
#ifdef HAS_BASELINE
    if(n<=cap) {
      auto e=events;
      auto r=records;
      reset(lane,n,p,t,d);
      if(std::string(name)=="High")lane.BaseHigh();
      else if(std::string(name)=="Medium")lane.BaseMedium();
      else lane.BaseLow();
      assert(events==e&&records==r);
    }
#endif
    ++total;
  }
  // An overflow frame followed by a small different view cannot replay stale IDs.
  reset(lane,cap+1,2,t,d);
  for(auto&v:lane.mSplatVertices)v.mPosition.x=42;
  (lane.*candidate)();
  reset(lane,3,2,t,d);
  for(auto&v:lane.mSplatVertices)v.mPosition.x=97;
  (lane.*candidate)();
  for(auto r:records)assert(r.second==97);
  // Fail each GAL stage in the helper path; no partial retry is allowed.
  reset(lane,cap+1,2,t,d);
  (lane.*candidate)();
  int stages=step;
  for(int k=2;k<stages;++k) {
    reset(lane,cap+1,2,t,d);
    failAt=k;
    bool fatal=false;
    try {
      (lane.*candidate)();
    }
    catch(Fatal&) {
      fatal=true;
    }
    assert(fatal&&step==k+1);
  }
  std::printf("%s: %d pass/count cases, independent full event order, %d overflow failure sites PASS\n",name,total,stages-2);
}
void helperCases() {
  gpg::gal::EffectTechnique t;
  t.passes=2;
  CD3DDevice d {
    {
      {
        &t
      }
    }
  };
  DrawLane lane;
  activeCap=250;
  reset(lane,251,2,t,d);
  DrawSplatChunksPassMajor(&d,&lane.sheet,&lane.index,lane.mSplatVertices.data(),lane.mSplatVertices.size(),250);
  const int stages=step;
  for(int k=0;k<stages;++k) {
    reset(lane,251,2,t,d);
    failAt=k;
    bool fatal=false;
    try {
      DrawSplatChunksPassMajor(&d,&lane.sheet,&lane.index,lane.mSplatVertices.data(),lane.mSplatVertices.size(),250);
    }
    catch(Fatal&) {
      fatal=true;
    }
    assert(fatal&&step==k+1);
  }
  reset(lane,1,1,t,d);
  bool bad=false;
  try {
    DrawSplatChunksPassMajor(&d,&lane.sheet,&lane.index,lane.mSplatVertices.data(),3,250);
  }
  catch(Fatal&) {
    bad=true;
  }
  assert(bad&&events.empty());
  bad=false;
  try {
    DrawSplatChunksPassMajor(&d,&lane.sheet,&lane.index,lane.mSplatVertices.data(),4,251);
  }
  catch(Fatal&) {
    bad=true;
  }
  assert(bad&&events.empty());
  bad=false;
  nullLock=true;
  try {
    DrawSplatChunksPassMajor(&d,&lane.sheet,&lane.index,lane.mSplatVertices.data(),4,250);
  }
  catch(Fatal&) {
    bad=true;
  }
  assert(bad);
  nullLock=false;
  puts("Helper invalid geometry, null lock, and every GAL failure site PASS");
}
int main() {
  cases("High",2500,&DrawLane::NewHigh);
  cases("Medium",2500,&DrawLane::NewMedium);
  cases("Low",250,&DrawLane::NewLow);
  helperCases();
  puts("PASS: source-bound submission and geometry mocks, not native renderer/driver/FPS");
}
